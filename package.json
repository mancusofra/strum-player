    "eslint-config-expo": "^58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.11",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
